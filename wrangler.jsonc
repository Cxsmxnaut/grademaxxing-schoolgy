{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "grademaxxing-schoology-local",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"directory": ".svelte-kit/cloudflare",
		"binding": "ASSETS",
		// SvelteKit handles page routes. Keep internal HTML assets directly readable.
		"html_handling": "none"
	},
	"compatibility_date": "2026-09-05",
	"workers_dev": true,
	"preview_urls": false,
	"observability": {
		"enabled": false
	},
	"secrets": {
		"required": [
			"GRADEMAXXING_SESSION_SECRET",
			"SCHOOLOGY_CONSUMER_KEY",
			"SCHOOLOGY_CONSUMER_SECRET"
		]
	},
	"vars": {
		"NODE_ENV": "production",
		"MAINTENANCE_MODE": "off"
	}
}
