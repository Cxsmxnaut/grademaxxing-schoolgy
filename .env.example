NODE_ENV=production
ORIGIN=https://grades.example.edu
HOST=127.0.0.1
PORT=3000
BODY_SIZE_LIMIT=64K

# StudentVUE operation capacity. Measure and tune with the district portal owner.
GRADEMAXXING_MAX_ACTIVE_OPERATIONS=96
GRADEMAXXING_MAX_QUEUED_OPERATIONS=1000
GRADEMAXXING_OPERATION_QUEUE_TIMEOUT_MS=30000

# At least 32 random characters. Required in production and shared by all instances.
# Generate with: openssl rand -base64 48
GRADEMAXXING_SESSION_SECRET=
GRADEMAXXING_SESSION_TTL_HOURS=12

# Set these only when TLS terminates at one trusted reverse proxy.
PROTOCOL_HEADER=x-forwarded-proto
HOST_HEADER=x-forwarded-host
ADDRESS_HEADER=x-forwarded-for
XFF_DEPTH=1

# Administrator access fails closed unless both secrets are configured.
# Password digest: SHA-256 of the operator password; never commit the password.
GRADEMAXXING_ADMIN_SECRET=
GRADEMAXXING_ADMIN_PASSWORD_HASH=
# Optional identity for the one configured operator (username defaults to admin).
GRADEMAXXING_ADMIN_USERNAME=admin
GRADEMAXXING_ADMIN_DISPLAY_NAME=Administrator

# Max AI provider keys: server-only comma-separated lists. Use Cloudflare secrets when deployed.
GROQ_API_KEYS=
OPENROUTER_API_KEYS=
GEMINI_API_KEYS=
MISTRAL_API_KEYS=
# Optional provider model/base URL overrides and attribution (APP_NAME / APP_URL).
