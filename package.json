{
	"name": "grademaxxing",
	"private": true,
	"version": "0.2.0-beta.1",
	"type": "module",
	"engines": {
		"node": ">=22.12"
	},
	"scripts": {
		"dev": "vite dev --host 127.0.0.1",
		"build": "vite build",
		"build:cloudflare": "DEPLOY_TARGET=cloudflare vite build",
		"preview:cloudflare": "npm run build:cloudflare && wrangler dev",
		"deploy:cloudflare": "npm run build:cloudflare && wrangler deploy",
		"preview": "node build",
		"test": "npm run test:unit",
		"test:unit": "vitest run src/tests",
		"test:watch": "vitest src/tests",
		"test:e2e": "playwright test",
		"test:human": "playwright test -c playwright.human.config.ts",
		"test:parity": "vite-node scripts/verify-studentvue-parity.ts",
		"benchmark:studentvue": "vite-node scripts/benchmark-studentvue-api.ts",
		"visual:diff": "vite-node scripts/compare-visual-parity.ts",
		"visual:audit": "vite-node scripts/report-visual-parity.ts",
		"test:release": "bash scripts/release-test.sh",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"check:dead-code": "knip --include files,dependencies,unlisted,unresolved,cycles",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "prettier --check . && eslint .",
		"verify": "npm run check && npm run lint && npm run check:dead-code && npm test",
		"generate-mocks": "bun run ./generate_mock_data.ts"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.13.0",
		"@eslint/compat": "^2.0.1",
		"@eslint/js": "^10.0.1",
		"@internationalized/date": "^3.10.1",
		"@lucide/svelte": "^0.562.0",
		"@playwright/test": "^1.55.0",
		"@sveltejs/adapter-cloudflare": "^7.2.9",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/adapter-vercel": "^6.3.4",
		"@sveltejs/kit": "^2.50.0",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/vite": "^4.1.18",
		"@types/bun": "^1.3.6",
		"@types/pngjs": "^6.0.5",
		"bits-ui": "^2.15.4",
		"clsx": "^2.1.1",
		"eslint": "^10.10.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.14.0",
		"fast-xml-parser": "^5.3.3",
		"file-type": "^21.3.0",
		"globals": "^17.0.0",
		"knip": "^6.35.1",
		"layerchart": "2.0.0-next.43",
		"msw": "^2.12.7",
		"pixelmatch": "^7.2.0",
		"pngjs": "^7.0.0",
		"prettier": "^3.8.0",
		"prettier-plugin-organize-imports": "^4.3.0",
		"prettier-plugin-svelte": "^3.4.1",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"svelte": "^5.46.4",
		"svelte-check": "^4.3.5",
		"svelte-eslint-parser": "^1.8.1",
		"svelte-sonner": "^1.0.7",
		"tailwind-merge": "^3.4.0",
		"tailwind-variants": "^3.2.2",
		"tailwindcss": "^4.1.18",
		"tw-animate-css": "^1.4.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.53.0",
		"vite": "^7.3.1",
		"vite-node": "^3.2.4",
		"vitest": "^4.1.11",
		"wrangler": "^4.131.1"
	},
	"msw": {
		"workerDirectory": [
			"static"
		]
	},
	"dependencies": {
		"@fontsource/ibm-plex-mono": "^5.3.0",
		"@fontsource/instrument-sans": "^5.3.0",
		"@fontsource/space-grotesk": "^5.3.0",
		"cheerio": "^1.2.0"
	},
	"overrides": {
		"cookie": "0.7.2"
	}
}
