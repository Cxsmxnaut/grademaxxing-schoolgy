{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "grademaxxing-beta",
	"account_id": "11d9c54af4e4fcae112a298e32cd2d59",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"directory": ".svelte-kit/cloudflare",
		"binding": "ASSETS"
	},
	"compatibility_date": "2026-09-05",
	"workers_dev": true,
	"routes": [
		{
			"pattern": "grademaxxing.app/*",
			"zone_id": "5da817dc2387bdda9145f245ed2974a4"
		},
		{
			"pattern": "admin.grademaxxing.app/*",
			"zone_id": "5da817dc2387bdda9145f245ed2974a4"
		}
	],
	"preview_urls": false,
	"observability": {
		"enabled": false
	},
	"secrets": {
		"required": ["GRADEMAXXING_SESSION_SECRET", "GRADEMAXXING_ANALYTICS_HMAC_SECRET"]
	},
	"analytics_engine_datasets": [
		{
			"binding": "GRADEMAXXING_USAGE_ANALYTICS",
			"dataset": "grademaxxing_usage"
		}
	],
	"d1_databases": [
		{
			"binding": "GRADEMAXXING_USAGE_DB",
			"database_name": "grademaxxing-usage",
			"database_id": "4061cd79-6b55-4379-bd99-ca7558c3baab",
			"migrations_dir": "migrations"
		}
	],
	"vars": {
		"NODE_ENV": "production"
	}
}
