NODE_ENV=production
ORIGIN=https://grades.example.edu
HOST=127.0.0.1
PORT=3000
BODY_SIZE_LIMIT=64K

# StudentVUE operation capacity. Measure and tune with the district portal owner.
GRADEMAXXING_MAX_ACTIVE_OPERATIONS=96
GRADEMAXXING_MAX_QUEUED_OPERATIONS=1000
GRADEMAXXING_OPERATION_QUEUE_TIMEOUT_MS=30000

# In-memory browser sessions for one long-lived Node process.
GRADEMAXXING_MAX_SESSIONS=5000
GRADEMAXXING_SESSION_TTL_HOURS=12

# Set these only when TLS terminates at one trusted reverse proxy.
PROTOCOL_HEADER=x-forwarded-proto
HOST_HEADER=x-forwarded-host
ADDRESS_HEADER=x-forwarded-for
XFF_DEPTH=1
